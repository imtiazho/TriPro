# Server Environment Configuration Example
NODE_ENV=development
PORT=5000

# MongoDB Connection URI (Replace with your Atlas or local connection string)
# Example: mongodb+srv://<db_username>:<db_password>@cluster0.ab3rgue.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://triUser:3vSlTdtFO8a27OHm@cluster0.ab3rgue.mongodb.net/

# Allowed Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin SDK Configuration (Optional in local dev fallback mode)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional Redis connection for BullMQ asynchronous background workers
# If empty, background deadline checks run on lightweight in-memory scheduler
REDIS_URL=

# Super-Admin One-Time Bootstrap Secret
BOOTSTRAP_SECRET=tripro_secure_bootstrap_key_change_in_production

# Evidence Document Storage Provider ('local' | 's3' | 'gcs')
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=./uploads

# Cache TTL in seconds for short-lived NodeCache
CACHE_TTL_SECONDS=300
